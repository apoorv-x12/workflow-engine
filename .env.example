# Postgres
POSTGRES_DB=workflow
POSTGRES_USER=user
POSTGRES_PASSWORD=pass

# API / worker runtime
API_BASE_URL=http://api:8000
CLAIM_TIMEOUT_SECONDS=15
REQUEST_TIMEOUT=10
WORKER_REPLICAS=2

# Optional local override when not using Docker Compose
# DATABASE_URL=sqlite:///./workflow.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/workflow
